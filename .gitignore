/target/

# Machine-specific settings: linker and SDK paths, and the [env] test inputs.
/.cargo/config.toml
/AGENTS.local.md

# Build output and local application data.
/dist/
/artifacts/
/desktop/*.log
/desktop/verification/
**/__pycache__/
tools/icons/_review/

